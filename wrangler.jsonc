{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warfields",
  "compatibility_date": "2026-09-01",
  // Assets-only Worker: Cloudflare serves the Vite build in dist/ directly, no Worker script.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
