{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warfields",
  "compatibility_date": "2026-09-01",
  // Build the game before every `wrangler deploy` / `wrangler dev`, so deploys never depend on
  // a separate build step being configured in the Cloudflare dashboard.
  "build": { "command": "npm run build" },
  // Assets-only Worker: Cloudflare serves the Vite build in dist/ directly, no Worker script.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Served at warfields.bkbuilds.dev. Requires the bkbuilds.dev zone on the same Cloudflare account;
  // Cloudflare creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "warfields.bkbuilds.dev", "custom_domain": true }]
}
